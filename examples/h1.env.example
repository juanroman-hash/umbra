# HackerOne API credentials for scripts/h1-scope.sh.
# Copy to .umbra/h1.env (which is gitignored) and fill in. NEVER commit real values,
# and never paste them into a chat. Create the token at: HackerOne → Settings → API Tokens.
# HackerOne uses HTTP Basic auth — the token IDENTIFIER is the username, the VALUE is the password.

HACKERONE_API_USERNAME=your-token-identifier
HACKERONE_API_TOKEN=your-token-value

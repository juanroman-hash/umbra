# Umbra bug-bounty profile — copy to .umbra/bounty.env and fill in for YOUR program.
# These knobs are read by /pentest-bounty and passed to workflows/engagement.js as
# the `bounty` profile. They tune Umbra down to bug-bounty-safe behavior; they do NOT
# grant authorization — enrollment in the program + its policy do that.

# Your researcher handle/username on the platform. Sent on every request for attribution.
BOUNTY_HANDLE=your-handle

# Header used to attribute traffic. Many programs specify one (e.g. X-HackerOne-Research,
# X-Bug-Bounty). Use whatever the program's policy requires; default X-Bug-Bounty.
BOUNTY_HEADER=X-Bug-Bounty

# Max requests per second PER HOST. Keep at or below the program's stated rate limit.
# Low by design — bounty targets are production systems.
BOUNTY_RATE_RPS=2

# How many solver subtasks may run at once. Low so the parallel fan-out can't exceed the
# rate limit or look like an attack.
BOUNTY_CONCURRENCY=2

# Extra tools this program bans, comma-separated (on top of the always-banned brute-force /
# high-volume / DoS set). E.g. "nikto,wpscan aggressive mode".
BOUNTY_BANNED_TOOLS=

# Explicitly OUT-of-scope assets to never touch, comma-separated. Copy the program's
# exclusions here (subdomains, third-party services, acquisitions, etc.).
BOUNTY_SCOPE_EXCLUDE=
